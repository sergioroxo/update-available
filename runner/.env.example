# Anthropic — only needed for --llm claude (Tier 1 docs, override, or triage recommendation)
# Default analysis path is LiteLLM (Mac Studio). Leave blank if not using Claude directly.
ANTHROPIC_API_KEY=sk-ant-...

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=
# Optional read-only token for GROQ lookups used during analysis/enrichment.
# Leave blank only when the dataset is publicly readable.
SANITY_READ_TOKEN=

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=

# Local paths
CORPUS_DIR=~/Documents/surviving-sogice-corpus
EXPORTS_DIR=~/Documents/surviving-sogice-exports
# Optional legacy vocabulary/tag registry folder. The folder should contain
# sogice_vocabulary_2026-04-03.csv. Used for broad tag hints in enrichment and
# for the knowledge-quality tag registry audit. Leave blank if unavailable; the
# pipeline will continue without registry hints.
SOGICE_LEGACY_VOCAB_DIR=

# Ollama (default: local)
# Run `ollama list` to see installed models and verify names match exactly.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:8b

# Three-tier local model strategy (Codex recommendation):
#   local           → everyday multilingual + JSON reliability
#   local-heavy     → long books / SRTs / rich interpretive fields (risk: high RAM — defer until Streamlit RAM monitor built)
#   local-reasoning → ambiguous docs, confidence scoring, evidence extraction
#
# Ollama model names (run `ollama pull <name>` to install):
#   qwen3.5:9b                 — safe default, good multilingual + JSON
#   gemma-4-26B-A4B-it         — heavy docs (verify RAM with Streamlit monitor first)
#   Ministral-3-14B-Reasoning-2512 — reasoning (verify exact name with `ollama list`)
LOCAL_ANALYSIS_MODEL=qwen3.5:9b
LOCAL_ANALYSIS_MODEL_HEAVY=gemma-4-26B-A4B-it
LOCAL_ANALYSIS_MODEL_REASONING=Ministral-3-14B-Reasoning-2512

# Claude model (update when Anthropic releases new versions)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_OUTPUT_TOKENS=8192

# OpenRouter (free tier available — no credit card needed for free models)
# Get key at: https://openrouter.ai/keys
# Browse free models at: https://openrouter.ai/models?q=free
# The :free suffix selects the free preview tier of a model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# LiteLLM proxy (Mac Studio M2 Ultra 64 GB via Tailscale)
# See 01_project_docs/MAC_STUDIO_SERVER_SETUP.md for full setup guide.
# Models exposed by LiteLLM (set in litellm_config.yaml on the Mac Studio):
#   core-qwen      → everyday analysis (--llm litelm)
#   core-gemma     → heavy / long docs  (--llm litelm-heavy)
#   review-qwen    → ambiguous / reasoning (--llm litelm-reasoning)
#   research-embedding → embeddings (used automatically when --llm litelm*)
LITELM_BASE_URL=https://<your-tailscale-hostname>.ts.net:4000
LITELM_API_KEY=sk-local-research-key-change-this
LITELM_ANALYSIS_MODEL=core-qwen
LITELM_ANALYSIS_MODEL_HEAVY=core-gemma
LITELM_ANALYSIS_MODEL_REASONING=review-qwen
LITELM_EMBEDDING_MODEL=research-embedding
# Enrichment model: core-gemma (Gemma4:31b) for cross-architecture diversity.
# Analysis uses Qwen (core-qwen); enrichment uses Gemma4 so systematic biases
# from one architecture do not propagate to the lexicon.
LITELM_ENRICHMENT_MODEL=core-gemma
LITELM_ENRICHMENT_MODEL_ALT=core-gemma
# Optional: direct Ollama endpoint for explicit unloads between LiteLLM stages.
# Leave blank unless the runner can reach the Mac Studio's Ollama API.
# If MAC_STUDIO_OLLAMA_URL is already set, it is used as a fallback.
LITELM_OLLAMA_BASE_URL=

# Source-offload transfer target (Streamlit "Source Offload" page, display only).
# Used to fill in the copy-paste rsync / source-worker commands. The app never
# SSHes/rsyncs or launches the worker — these only make the shown commands
# ready-to-run. Leave blank to see placeholders.
#   MAC_STUDIO_SSH_HOST     e.g. cdn-ai@mqvlfwcwmc.tail379051.ts.net
#   MAC_STUDIO_OFFLOAD_ROOT private owner-only root on the Mac Studio
#   MAC_STUDIO_PYTHON       Mac Studio repo venv python (NOT bare python3), so
#                           the shown `source-worker` command has all deps, e.g.
#                           /Users/cdn-ai/surviving-sogice-ingest/.venv/bin/python
MAC_STUDIO_SSH_HOST=
MAC_STUDIO_OFFLOAD_ROOT=/Users/cdn-ai/sogice-offload
MAC_STUDIO_PYTHON=

# Phase 2B synthetic factory (opt-in, non-default, no research data or models).
# MacBook: set both shared replica paths, JOB_ROOT for synthetic fixture/control
# records, HOST_ROLE=macbook, and DRY_RUN_ONLY=true. STATE_ROOT is configured so
# overlap checks can prove it remains outside Syncthing; the MacBook never opens it.
# Mac Studio: use its local replicas, a private STATE_ROOT and JOB_ROOT outside
# Syncthing, HOST_ROLE=mac-studio, and DRY_RUN_ONLY=true.
SOGICE_FACTORY_TO_STUDIO=
SOGICE_FACTORY_FROM_STUDIO=
SOGICE_FACTORY_STATE_ROOT=
SOGICE_FACTORY_JOB_ROOT=
SOGICE_FACTORY_HOST_ROLE=
SOGICE_FACTORY_DRY_RUN_ONLY=false

# Phase 2C1 production-canary readiness (still unreleased in Run-009).
# All paths must be absolute and host-local. Never place keys, logs, state, or
# the generated plist inside either Syncthing folder. Public-key allow-lists
# accept comma-separated paths. These are placeholders only.
SOGICE_FACTORY_PRODUCTION_CANARY_ENABLED=false
SOGICE_FACTORY_MAX_COPIED_TEXT_BYTES=1048576
SOGICE_FACTORY_MACBOOK_SIGNING_PRIVATE_KEY=
SOGICE_FACTORY_STUDIO_COMMAND_PUBLIC_KEYS=
SOGICE_FACTORY_STUDIO_RECEIPT_SIGNING_PRIVATE_KEY=
SOGICE_FACTORY_MACBOOK_RECEIPT_PUBLIC_KEYS=
SOGICE_FACTORY_SERVICE_LOG_ROOT=
SOGICE_FACTORY_SERVICE_POLL_SECONDS=5
SOGICE_FACTORY_LAUNCH_AGENT_LABEL=org.survivingsogice.factory
SOGICE_FACTORY_LAUNCH_AGENT_PLIST_OUTPUT=
LITELM_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
# Actual Ollama model names behind LiteLLM aliases. These are used only for
# explicit unloads between stages so embedding and analysis models do not sit
# in RAM together. Set these to the names shown by `ollama ps` / `ollama list`
# on the Mac Studio if they differ from the LiteLLM aliases.
LITELM_OLLAMA_TRIAGE_MODEL=gemma4:12b-mlx
LITELM_OLLAMA_ANALYSIS_MODEL=qwen3.6:35b-mlx
LITELM_OLLAMA_ANALYSIS_MODEL_HEAVY=gemma4:31b-mlx
LITELM_OLLAMA_ANALYSIS_MODEL_REASONING=qwen3.6:27b-mlx
# Triage model (fast pre-screen — Stage 0.5). triage alias -> gemma4:12b-mlx on Mac Studio.
# Used with: python -m runner ingest <url> --triage
# Stage 3c enrichment model. lexicon-llm/core-gemma should map to Gemma heavy in LiteLLM.
# Used with: python -m runner ingest <url> --enrich  OR  python -m runner enrich <doc_id>
# Use --second-opinion to run both and compare. ALT is used by --second-opinion.
# LITELM_ENRICHMENT_MODEL and LITELM_ENRICHMENT_MODEL_ALT already set above.

# Truncation limits (characters, not tokens).
# TRUNCATION_LIMIT applies when --llm claude (API cost reason: default 24k).
# TRUNCATION_LIMIT_LOCAL applies when --llm local/litelm* — Mac Studio handles
# long context well. 1,000,000 chars is roughly 200k-250k tokens for many
# English/European-language documents, depending on formatting.
# Claude API: keep low to control cost (24k chars ≈ 6k tokens).
TRUNCATION_LIMIT=24000
# LiteLLM/local: 250k chars ≈ 62k tokens — fits comfortably in qwen3.6's 262k
# context window. For books, use runner split-book which handles full text via
# chapter splitting. Set to 0 to disable truncation entirely (not recommended).
TRUNCATION_LIMIT_LOCAL=250000
# End-aware truncation: keeps head + tail when truncation fires.
TRUNCATION_HEAD_CHARS=20000
TRUNCATION_TAIL_CHARS=8000

# Local/Ollama context and output budgets (tokens).
# Qwen 3.6 local is commonly run at 262k; Gemma large around 256k.
LOCAL_CONTEXT_TOKENS=262144
LOCAL_OUTPUT_TOKENS=16384

# Optional acquisition fallbacks.
# MarkItDown is used automatically as a local-file/PDF fallback if the package
# is installed. It is not required for normal ingest.
#
# Crawl4AI can render public pages with a local headless browser when enabled.
# This is deliberately opt-in because it may start Playwright/browser processes.
# The runner uses no cookies, persistent profiles, proxies, stealth mode, or
# CAPTCHA solving. Challenges are still detected and held when rendered.
SOGICE_ENABLE_CRAWL4AI=false
